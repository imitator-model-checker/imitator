(* Mikael
Location abstraction might explore things that are unreachable here
  *)

uncontrollable actions:;

var 
    x,
    y : clock;
    p : parameter;



automaton ptg1

actions: a, b;

loc l0: invariant True
    when x = 1 sync a goto l1;

loc l1: invariant True
    when x = p sync b goto l2;

loc l2: invariant True
    when True goto l3;

loc l3: invariant True
    when True goto l4;

loc l4: invariant True
    when True goto l5;

accepting loc l5: invariant True

end

automaton ptg2

actions: a, b;

loc l0: invariant True
    when y = 1 sync a goto l1;

loc l1: invariant True
    when y < p sync b goto l2;

loc l2: invariant True
    when True goto l3;

loc l3: invariant True
    when True goto l4;

loc l4: invariant True
    when True goto l5;

accepting loc l5: invariant True

end


init := {
	
    discrete =
		(*------------------------------------------------------------*)
		(* Initial location *)
		(*------------------------------------------------------------*)
		loc[ptg1] := l0,
        loc[ptg2] := l0,

		(*------------------------------------------------------------*)
		(* Initial discrete variables assignments *)
		(*------------------------------------------------------------*)

    ;

    continuous =        
		(*------------------------------------------------------------*)
		(* Initial clock constraints *)
		(*------------------------------------------------------------*)
		& p >= 0

		(*------------------------------------------------------------*)
		(* Parameter constraints *)
		(*------------------------------------------------------------*)
	;
}


end