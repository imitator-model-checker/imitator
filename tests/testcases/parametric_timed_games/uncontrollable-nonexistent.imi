(************************************************************
 *                                IMITATOR MODEL
 *
 * Title            : Testing the behavior in the case of an undeclared controllable action
 * Description      : Testing the behavior in the case of an undeclared controllable action
 * Correctness      : N/A
 * Scalable         : no
 * Generated        : no
 * Categories       : TBD
 * Source           : Own work
 * bibkey           : 
 * Author           : Étienne André
 * Modeling         : Étienne André
 * Input by         : Étienne André
 * License          : Creative Commons Attribution-ShareAlike 4.0 International (CC BY-SA 4.0)
 *
 * Created          : 2025/01/09
 * Last modified    : 2025/01/09
 * Model version    : 0.1
 *
 * IMITATOR version : 3.4-alpha
 ************************************************************)

uncontrollable actions: idontexist;

var

(* Clocks *)
 	x,
		: clock;



(************************************************************)
  automaton pta
(************************************************************)
actions: a, b;


loc l1: invariant True
	when x = 1 sync a do {} goto l1;
	when x > 1 sync b do {} goto l1;

end (* pta *)



(************************************************************)
(* Initial state *)
(************************************************************)

init = {
	
    discrete =
		(*------------------------------------------------------------*)
		(* Initial location *)
		(*------------------------------------------------------------*)
		loc[pta] <- l1,

		(*------------------------------------------------------------*)
		(* Initial discrete variables assignments *)
		(*------------------------------------------------------------*)

    ;

    continuous =        
		(*------------------------------------------------------------*)
		(* Initial clock constraints *)
		(*------------------------------------------------------------*)
		& x = 0

		(*------------------------------------------------------------*)
		(* Parameter constraints *)
		(*------------------------------------------------------------*)
	;
}


(************************************************************)
(* The end *)
(************************************************************)
end
