(* Mikael

	Should return True but returns False with including check (or double inclusion check) without handling it properly
	Should return True in both cases if handling it properly.
  *)

controllable actions: c1;

var x: clock;

automaton ptg

actions: c1;

loc l0: invariant True
    when x = 1 do {} sync c1 goto l1;

loc l1: invariant True 
	when x = 0 do {} sync c1 goto win;
	when True do {} sync c1 goto l2;

loc l2: invariant True 
	when True do {x:=0} sync c1 goto l1;

accepting loc win: invariant True 


end
init := {
	
    discrete =
		(*------------------------------------------------------------*)
		(* Initial location *)
		(*------------------------------------------------------------*)
		loc[ptg] := l0,

		(*------------------------------------------------------------*)
		(* Initial discrete variables assignments *)
		(*------------------------------------------------------------*)

    ;

    continuous =        
		(*------------------------------------------------------------*)
		(* Initial clock constraints *)
		(*------------------------------------------------------------*)
		& x = 0

		(*------------------------------------------------------------*)
		(* Parameter constraints *)
		(*------------------------------------------------------------*)
	;
}


end