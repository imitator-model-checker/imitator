(* Mikael, Aarhus, March 24, 2023 
	Simple PTG
    Expected constraint: 0 <= p <= 5
*)

controllable actions: c;

var
 	x : clock;
    y: clock;
    p : parameter;

automaton ptg

actions: c;

loc l1: invariant True
	when x = 1 do {x:=0} sync c goto l1;
    when y = p sync c goto l2;

loc l2 : invariant True
    when True do {y := 0; x:=0} sync c goto l3;

loc l3 : invariant True
    when x = 1 do {x := 0} sync c goto l3;
    when y = p sync c goto l4;

accepting loc l4 : invariant True



end (* ptg *)

init :=
	& loc[ptg] = l1
	& x = 0
    & y = 0
	& p >= 0
;

end
