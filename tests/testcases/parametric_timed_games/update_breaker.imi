(* Mikael, Aarhus, March 24, 2023 
	Simple PTG
    Expected constraint: 0 <= p <= 5
*)

uncontrollable actions: u_1, u_2;

var
 	x : clock;
    y: clock;
    p : parameter;

automaton ptg

actions: c_1, c_2, u_1, u_2, c_1p, c_2p, c_3p;

loc L_i: invariant True
	when x > 0 do {x:=0} sync u_1 goto L_1;
    when x = 0 sync c_1p goto L_1p;

loc L_1: invariant True
    when y >= p sync u_2 goto Goal;
    when y >= p & x <= 1 sync c_2 goto Goal;
    when x <= 1 do {x:=0} sync c_1 goto L_1;

loc L_1p: invariant True
    when True sync c_2p goto L_2p;

loc L_2p: invariant True
    when True sync c_3p goto Goal;

accepting loc Goal: invariant True



end (* ptg *)

init :=
	& loc[ptg] = L_i
	& x = 0
    & y = 0
	& p >= 0
;

end
