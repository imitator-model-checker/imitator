(* Mikael, Aarhus, Oct 12, 2023 
	Test if inclusion checking updates dependencies correctly
*)

controllable actions: c_1, c_2, c_3, c_4;

var
 	x : clock;

automaton ptg

actions: c_1, c_2, c_3, c_4, u_1;

loc l1: invariant True
	when True sync c_1 goto l2;
    when x >= 5 sync c_2 goto l3;

loc l2: invariant True
    when True sync u_1 goto Goal;

loc l3: invariant True 
    when True sync c_3 goto l4;

loc l4: invariant True
    when True sync c_4 goto Goal;


accepting loc Goal: invariant True

end (* ptg *)

init :=
	& loc[ptg] = l1
	& x = 0
;

end
