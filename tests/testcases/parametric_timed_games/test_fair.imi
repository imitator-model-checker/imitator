uncontrollable actions: u;

var x,y:clock;
    p:parameter;

automaton test

actions: c1, c2, u;

loc l0: invariant True
    when x=p do {x:=0, y:=0}  sync c1 goto l1;

loc l1: invariant True
    when x=1 && y<p do {x:=0} sync u goto l1;
    when y=p do {} sync c2 goto l2;

accepting loc l2: invariant True
    when True goto l2;
end

init := loc[test] = l0
     & p>=0
     & x=0
     & y=0
     ;
end
