(* Mikael
Test how PTG merge algo interacts with updates

  *)

uncontrollable actions:;

var p : parameter;

automaton ptg

actions:;

loc l0: invariant True
    when 0 <= p & p <= 1 goto win;
    when 1 <= p & p <= 2 goto l1;

loc l1: invariant True
    when True goto win;


accepting loc win: invariant True


end
init := {
	
    discrete =
		(*------------------------------------------------------------*)
		(* Initial location *)
		(*------------------------------------------------------------*)
		loc[ptg] := l0,

		(*------------------------------------------------------------*)
		(* Initial discrete variables assignments *)
		(*------------------------------------------------------------*)

    ;

    continuous =        
		(*------------------------------------------------------------*)
		(* Initial clock constraints *)
		(*------------------------------------------------------------*)
		& p >= 0

		(*------------------------------------------------------------*)
		(* Parameter constraints *)
		(*------------------------------------------------------------*)
	;
}


end