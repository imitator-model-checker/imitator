(* Mikael, Aarhus, March 21, 2023 
	Simple PTG
    Expected constraint: 
*)

controllable actions: c_1;

var
 	x : clock;

automaton ptg

actions: c_1, u_1;

loc L0: invariant True
	when 1 <= x && x <= 4 sync c_1 goto Win;
    when 2 <= x && x <= 3  sync u_1 goto Lose;

accepting loc Win: invariant True

loc Lose : invariant True

end (* ptg *)

init :=
	& loc[ptg] = L0
	& x = 0
;

end
