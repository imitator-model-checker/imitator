(* Mikael, Aarhus, March 21, 2023 
	Simple PTG
    Expected constraint: False
*)

controllable actions: c_1;

var
 	x,y : clock;

automaton ptg

actions: c_1, u_1;

loc l1: invariant True
	when y >= 3 sync c_1 goto Goal;
    when x = 1 do {x:=0} sync c_1 goto l1;
	when x > 1 sync u_1 goto l2;

accepting loc Goal: invariant True

loc l2: invariant True


end (* ptg *)

init :=
	& loc[ptg] = l1
	& x = 0
	& y = 0
;

end
