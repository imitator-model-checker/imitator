(* Mikael, Aarhus, June 25, 2025
Modified for formats presentation
*)

controllable actions: c_2, c_3;

var
    p : parameter;
 	x : clock;

automaton ptg

actions: c_2, c_3, u_1, u_2;

loc L0: invariant x < 10
    when True sync u_1 goto L1;

loc L1: invariant True 
    when 1 < x sync c_2 goto L2;


loc L2: invariant True 
    when x > p do {x:=0} sync u_2 goto L1;
    when True sync c_3 goto Win;

accepting loc Win: invariant True

end (* ptg *)

init :=
	& loc[ptg] = L0
	& x = 0
    & p >= 0
;

end
