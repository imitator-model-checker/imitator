(* Mikael

For Baptiste presentation FORMATS
*)

controllable actions: sugar_added, serve_coffee;

var
 	x,
    y,
        : clock;

    p
        : parameter;

automaton ptg

actions: sugar_added, serve_coffee, ask_coffee, ask_sugar, take_coffee;

loc idle: invariant True
	when True do {x:=0} sync ask_coffee goto preparing_coffee;


loc preparing_coffee : invariant True
    when x < p do {y:=0} sync ask_sugar goto adding_sugar;
    when 3 < x sync serve_coffee goto coffee_served;

loc adding_sugar : invariant True
    when y = 1 sync sugar_added goto preparing_coffee; 

accepting loc coffee_served : invariant x < 5
    when True sync take_coffee goto idle;

end (* ptg *)

init :=
	& loc[ptg] = preparing_coffee
    & x = 0
    & y = 0
    & p >= 0
;

end
