controllable actions: c;

var
	x : clock;
	p : parameter;

automaton PTG

actions: c, u;

loc l1: invariant True		(* L1 *)
	when x>=2 sync c goto Goal;
	when x<1 sync u goto l2;

loc l2: invariant True		(* L2 *)
	when True sync c goto l3;

loc l3: invariant True		(* L3 *)
	when x<=p sync c goto l1;

accepting loc Goal: invariant True		(* goal *)

end

init :=
	& loc[PTG] = l1
	& x = 0
	& p >= 0
;

end