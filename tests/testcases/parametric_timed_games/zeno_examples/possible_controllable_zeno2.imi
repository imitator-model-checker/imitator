controllable actions: c;

var
	x, y : clock;

automaton PTG

actions: c;

loc l1: invariant True  	(* L1 *)
	when x>=2 sync c goto Goal;
	when y=0 sync c goto l2;

loc l2: invariant True	(* L2 *)
	when y=0 sync c goto l1;


accepting loc Goal: invariant True		(* goal *)

end

init :=
	& loc[PTG] = l1
	& x = 0
;

end