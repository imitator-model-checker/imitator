(************************************************************
 *                                IMITATOR MODEL
 *
 * Title            : Check that an int variable is not compared to a rational in a guard
 * Description      : Check that an int variable is not compared to a rational in a guard
 * Correctness      : Type error
 * Scalable         : No
 * Generated        : No
 * Categories       : Semantic, Type Checking
 * Source           : 
 * bibkey           : 
 * Author           : Étienne André
 * Modeling         : Étienne André
 * Input by         : Étienne André
 * License          : Creative Commons Attribution-ShareAlike 4.0 International (CC BY-SA 4.0)
 *
 * Created          : 2026/05/29
 * Last modified    : 2026/05/29
 * Model version    : 1.0
 *
 * IMITATOR version : 3.4-beta
 ************************************************************)
var 
    i,
        : int;
    j
        : rational;


(************************************************************)
 automaton pta
(************************************************************)
 
loc l1: invariant True 
	when i = 3/2 goto lend;
	
accepting loc lend: invariant True
 end (* pta *)
(************************************************************)


(************************************************************)
(* Initial state *)
(************************************************************)


init := {

    discrete = 
        loc[pta] := l1,
        i := 5,
    ;
    
}



(************************************************************)
(* The end *)
(************************************************************)
end
