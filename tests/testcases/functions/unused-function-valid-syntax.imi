var

function unused_f(a : int, b : int) : rational
begin 
  return rational_of_int(a * b);
end 

(************************************************************)
 automaton pta1
(************************************************************)
actions : a;
loc l1: invariant True
  when True sync a goto lend;
(*   when unused_f(0, 0) = unused_f(0, 0) sync a goto lend; *)


accepting loc lend: invariant True

 end (* pta *)
(************************************************************)

(************************************************************)
(* Initial state *)
(************************************************************)


init := {

    continuous =
      True
    ;

    discrete =
      loc[pta1] <- l1
    ;

}



(************************************************************)
(* The end *)
(************************************************************)
end
