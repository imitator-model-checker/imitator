var



fn plus_one(my_variable : rat) : rat
begin
  return my_variable + 1
end

(* my own not using not *)
fn my_not(my_variable : bool) : bool
begin
  return not(my_variable)
end


automaton P

  loc l0: invariant True

  when my_not(True) & plus_one(4.98) = plus_one(4.98) goto lend;

  accepting loc lend : invariant True

end

init := {
    discrete =
      loc[P] := l0,
    ;
}
