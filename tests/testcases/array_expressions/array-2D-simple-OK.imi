 * Created          : 2026/06/01
 * Last modified    : 2026/06/01
 * Model version    : 1.0
 *
 * IMITATOR version : 3.4-beta
 ************************************************************)

var

  my_2S_int_array : int array(2) array(2);

automaton A

  loc s0: invariant True
  when my_2S_int_array[1][1] = 4 do { my_2S_int_array[1][1] <- 5 } goto s0;
  when my_2S_int_array[1][1] = 5 do { my_2S_int_array[1][1] <- 6 } goto lend;

  accepting loc lend : invariant my_2S_int_array[1][1] = 6

end


init <- {
  discrete =
    loc[A] <- s0,
    my_2S_int_array <- [[1,2] , [3,4]]
  ;

}
