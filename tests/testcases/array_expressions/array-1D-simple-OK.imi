 *
 * IMITATOR version : 3.4-beta
 ************************************************************)

var

  my_int_array : int array(4);

automaton A

  loc s0: invariant True
  when my_int_array[1] = 0 do { my_int_array[1] <- 1 } goto s0;
  when my_int_array[1] = 1 do { my_int_array[1] <- 2 } goto lend;

  accepting loc lend : invariant my_int_array[1] = 2

end


init <- {
  discrete =
    loc[A] <- s0,
    my_int_array <- [0,0,0,0]
  ;

}
