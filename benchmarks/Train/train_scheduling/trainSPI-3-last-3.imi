(************************************************************
 *                                IMITATOR MODEL
 *
 * Title            : Some alternative modeling for Figure 4 in "Railway Scheduling Using Boolean Satisfiability Modulo Simulations"
 * Description      : Some alternative modeling for Figure 4 in "Railway Scheduling Using Boolean Satisfiability Modulo Simulations" by Tomáš Kolárik and Stefan Ratschan, i.e., serial-parallel infrastructure, with N_S = N_P = 3. Scenario "last" with N_T = 3.
 * Correctness      : Satisfiable schedule
 * Scalable         : yes
 * Generated        : no
 * Categories       : train
 * Source           : "Railway Scheduling Using Boolean Satisfiability Modulo Simulations" by Tomáš Kolárik and Stefan Ratschan. Formal Methods 2023. DOI: https://doi.org/10.1007/978-3-031-27481-7_5
 * bibkey           : [KR23]
 * Author           : Étienne André
 * Modeling         : Étienne André
 * Input by         : Étienne André
 * License          : Creative Commons Attribution-ShareAlike 4.0 International (CC BY-SA 4.0)
 *
 * Created          : 2024/05/02
 * Last modified    : 2024/07/05
 * Model version    : 0.1
 *
 * IMITATOR version : 3.4-alpha
 ************************************************************)

var

(* Number of trains *)
	NB = 3 : int;

(************************************************************)
#include "trainSPI-3-common.imi";
(************************************************************)

(************************************************************)
  automaton scheduler
(************************************************************)
actions: forall i in [0 , NB-1] : start_array[i], done_array[NB-1];

loc loc_1: invariant True stop{x_last}
	when True sync start_array[0] goto loc_2;

loc loc_2: invariant True stop{x_last}
	when True sync start_array[1] do {x_last := 0} goto loc_3;

loc loc_3: invariant True stop{x_last}
	when True sync start_array[2] do {x_last := 0} goto loc_4;

loc loc_4: invariant x_last <= bound_last
	when x_last <= bound_last sync done_array[NB-1] do {x_last := 0} goto loc_F;

loc loc_F: invariant True stop{x_last}

end (* pta *)

(************************************************************)
#include "trainSPI-3-initialstate.imi";
(************************************************************)


(************************************************************)
(* The end *)
(************************************************************)
end
