(************************************************************)
  automaton train_Green
(************************************************************)
(*** Connection: [A, 3] ***)
actions: done_Green;

(*** NOTE: we statically remove unreachable nodes considering the connection ***)

loc node_A: invariant True
	when segment_1_free do {x_Green := 0; segment_1_free := False} goto segment_1;

loc segment_1: invariant x_Green <= DURATION_SEGMENT_1
	when x_Green = DURATION_SEGMENT_1 & segment_2_free do {x_Green := 0; segment_2_free := False} goto segment_1_2;
	when x_Green = DURATION_SEGMENT_1 & segment_3_free do {x_Green := 0; segment_3_free := False} goto segment_1_3;

loc segment_1_2: invariant x_Green <= DURATION_SEGMENT_1_2
	when x_Green = DURATION_SEGMENT_1_2 do {x_Green := 0; segment_1_free := True} goto segment_2;

loc segment_1_3: invariant x_Green <= DURATION_SEGMENT_1_3
	when x_Green = DURATION_SEGMENT_1_3 do {x_Green := 0; segment_1_free := True} goto segment_3;

loc segment_2: invariant x_Green <= DURATION_SEGMENT_2
	when x_Green = DURATION_SEGMENT_2 & segment_6_free do {x_Green := 0; segment_6_free := False} goto segment_2_6;
	when x_Green = DURATION_SEGMENT_2 & segment_7_free do {x_Green := 0; segment_7_free := False} goto segment_2_7;

(* Train station 1 *)
loc segment_2_6: invariant x_Green <= DURATION_SEGMENT_2_6
	(*** Not part of the connection: no stop ***)
	when x_Green = DURATION_SEGMENT_2_6 do {x_Green := 0; segment_2_free := True} goto segment_6;

(* Train station 1 *)
loc segment_2_7: invariant x_Green <= DURATION_SEGMENT_2_7
	(*** Not part of the connection: no stop ***)
	when x_Green = DURATION_SEGMENT_2_7 do {x_Green := 0; segment_2_free := True} goto segment_7;

loc segment_3: invariant x_Green <= DURATION_SEGMENT_3
	when x_Green = DURATION_SEGMENT_3 & segment_4_free do {x_Green := 0; segment_4_free := False} goto segment_3_4;
(* 	when x_Green = DURATION_SEGMENT_3 & segment_5_free do {x_Green := 0; segment_5_free := False} goto segment_3_5; *)

loc segment_3_4: invariant x_Green <= DURATION_SEGMENT_3_4
	when x_Green = DURATION_SEGMENT_3_4 do {x_Green := 0; segment_3_free := True} goto segment_4;

(*loc segment_3_5: invariant x_Green <= DURATION_SEGMENT_3_5
	when x_Green = DURATION_SEGMENT_3_5 do {x_Green := 0; segment_3_free := True} goto segment_5;*)

loc segment_4: invariant x_Green <= DURATION_SEGMENT_4
	when x_Green = DURATION_SEGMENT_4 & segment_8_free do {x_Green := 0; segment_8_free := False} goto segment_4_8;
(* 	when x_Green = DURATION_SEGMENT_4 & segment_9_free do {x_Green := 0; segment_9_free := False} goto segment_4_9; *)

(* Train station 2 *)
loc segment_4_8: invariant x_Green <= DURATION_SEGMENT_4_8
	(*** Not part of the connection: no stop ***)
	when x_Green = DURATION_SEGMENT_4_8 do {x_Green := 0; segment_4_free := True} goto segment_8;

(*(* Train station 2 *)
loc segment_4_9: invariant x_Green <= DURATION_SEGMENT_4_9
	(*** Not part of the connection: no stop ***)
	when x_Green = DURATION_SEGMENT_4_9 do {x_Green := 0; segment_9_free := True} goto segment_9;*)

(*(* Terminal, wrong node *)
loc segment_5: invariant x_Green <= DURATION_SEGMENT_5
	when x_Green = DURATION_SEGMENT_5 do {x_Green := 0; segment_5_free := True} goto node_B;*)

loc segment_6: invariant x_Green <= DURATION_SEGMENT_6
	when x_Green = DURATION_SEGMENT_6 & segment_11_free do {x_Green := 0; segment_11_free := False} goto segment_6_11;

loc segment_7: invariant x_Green <= DURATION_SEGMENT_7
	when x_Green = DURATION_SEGMENT_7 & segment_10_free do {x_Green := 0; segment_10_free := False} goto segment_7_10;

(* Train station 3 *)
loc segment_6_11: invariant x_Green <= DURATION_SEGMENT_6_11
	(*** Part of the connection: stop ***)
	when x_Green >= DURATION_SEGMENT_6_11 do {x_Green := 0; segment_6_free := True} goto segment_11;

loc segment_7_10: invariant x_Green <= DURATION_SEGMENT_7_10
	when x_Green = DURATION_SEGMENT_7_10 do {x_Green := 0; segment_7_free := True} goto segment_10;

loc segment_8: invariant x_Green <= DURATION_SEGMENT_8
	when x_Green = DURATION_SEGMENT_8 & segment_10_free do {x_Green := 0; segment_10_free := False} goto segment_8_10;

loc segment_8_10: invariant x_Green <= DURATION_SEGMENT_8_10
	when x_Green = DURATION_SEGMENT_8_10 do {x_Green := 0; segment_8_free := True} goto segment_10;

(*(* Terminal, wrong node *)
loc segment_9: invariant x_Green <= DURATION_SEGMENT_9
	when x_Green = DURATION_SEGMENT_9 do {x_Green := 0; segment_9_free := True} goto node_C;*)

(* Terminal, success *)
loc segment_10: invariant x_Green <= DURATION_SEGMENT_10
	when x_Green = DURATION_SEGMENT_10 do {x_Green := 0; segment_10_free := True} sync done_Green goto node_D;

(* Terminal, success *)
loc segment_11: invariant x_Green <= DURATION_SEGMENT_11
	when x_Green = DURATION_SEGMENT_11 do {x_Green := 0; segment_11_free := True} sync done_Green goto node_D;

loc node_B: invariant True stop{x_Green}
loc node_C: invariant True stop{x_Green}
loc node_D: invariant True stop{x_Green}

end (* pta *)



