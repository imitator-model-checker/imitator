	when x_array[i] = DURATION_SEGMENT_S4_P1 do {x_array[i] := 0; segment_S4_P1_A_free := True} goto segment_S4_P1_B;

loc segment_S4_P1_B: invariant x_array[i] <= DURATION_SEGMENT_S4_P1_B
	when x_array[i] = DURATION_SEGMENT_S4_P1_B & segment_S4_E_free do {x_array[i] := 0; segment_S4_E_free := False} goto segment_S4_Exit_P1;

loc segment_S4_Exit_P1: invariant x_array[i] <= DURATION_SEGMENT_S4_EXIT
	when x_array[i] = DURATION_SEGMENT_S4_EXIT do {x_array[i] := 0; segment_S4_P1_B_free := True} goto segment_S4_E;

(* S4 : P2 *)
loc segment_S4_Enter_P2: invariant x_array[i] <= DURATION_SEGMENT_S4_ENTER
	when x_array[i] = DURATION_SEGMENT_S4_ENTER do {x_array[i] := 0; segment_S3_S4_free := True} goto segment_S4_P2_A;

loc segment_S4_P2_A: invariant x_array[i] <= DURATION_SEGMENT_S4_P2_A
	when x_array[i] = DURATION_SEGMENT_S4_P2_A & segment_S4_P2_B_free do {x_array[i] := 0; segment_S4_P2_B_free := False} goto segment_S4_P2;

loc segment_S4_P2: invariant x_array[i] <= DURATION_SEGMENT_S4_P2
	when x_array[i] = DURATION_SEGMENT_S4_P2 do {x_array[i] := 0; segment_S4_P2_A_free := True} goto segment_S4_P2_B;

loc segment_S4_P2_B: invariant x_array[i] <= DURATION_SEGMENT_S4_P2_B
	when x_array[i] = DURATION_SEGMENT_S4_P2_B & segment_S4_E_free do {x_array[i] := 0; segment_S4_E_free := False} goto segment_S4_Exit_P2;

loc segment_S4_Exit_P2: invariant x_array[i] <= DURATION_SEGMENT_S4_EXIT
	when x_array[i] = DURATION_SEGMENT_S4_EXIT do {x_array[i] := 0; segment_S4_P2_B_free := True} goto segment_S4_E;

(* S4 : P3 *)
loc segment_S4_Enter_P3: invariant x_array[i] <= DURATION_SEGMENT_S4_ENTER
	when x_array[i] = DURATION_SEGMENT_S4_ENTER do {x_array[i] := 0; segment_S3_S4_free := True} goto segment_S4_P3_A;

loc segment_S4_P3_A: invariant x_array[i] <= DURATION_SEGMENT_S4_P3_A
	when x_array[i] = DURATION_SEGMENT_S4_P3_A & segment_S4_P3_B_free do {x_array[i] := 0; segment_S4_P3_B_free := False} goto segment_S4_P3;

loc segment_S4_P3: invariant x_array[i] <= DURATION_SEGMENT_S4_P3
	when x_array[i] = DURATION_SEGMENT_S4_P3 do {x_array[i] := 0; segment_S4_P3_A_free := True} goto segment_S4_P3_B;

loc segment_S4_P3_B: invariant x_array[i] <= DURATION_SEGMENT_S4_P3_B
	when x_array[i] = DURATION_SEGMENT_S4_P3_B & segment_S4_E_free do {x_array[i] := 0; segment_S4_E_free := False} goto segment_S4_Exit_P3;

loc segment_S4_Exit_P3: invariant x_array[i] <= DURATION_SEGMENT_S4_EXIT
	when x_array[i] = DURATION_SEGMENT_S4_EXIT do {x_array[i] := 0; segment_S4_P3_B_free := True} goto segment_S4_E;

(* S4 : P4 *)
loc segment_S4_Enter_P4: invariant x_array[i] <= DURATION_SEGMENT_S4_ENTER
	when x_array[i] = DURATION_SEGMENT_S4_ENTER do {x_array[i] := 0; segment_S3_S4_free := True} goto segment_S4_P4_A;

loc segment_S4_P4_A: invariant x_array[i] <= DURATION_SEGMENT_S4_P4_A
	when x_array[i] = DURATION_SEGMENT_S4_P4_A & segment_S4_P4_B_free do {x_array[i] := 0; segment_S4_P4_B_free := False} goto segment_S4_P4;

loc segment_S4_P4: invariant x_array[i] <= DURATION_SEGMENT_S4_P4
	when x_array[i] = DURATION_SEGMENT_S4_P4 do {x_array[i] := 0; segment_S4_P4_A_free := True} goto segment_S4_P4_B;

loc segment_S4_P4_B: invariant x_array[i] <= DURATION_SEGMENT_S4_P4_B
	when x_array[i] = DURATION_SEGMENT_S4_P4_B & segment_S4_E_free do {x_array[i] := 0; segment_S4_E_free := False} goto segment_S4_Exit_P4;

loc segment_S4_Exit_P4: invariant x_array[i] <= DURATION_SEGMENT_S4_EXIT
	when x_array[i] = DURATION_SEGMENT_S4_EXIT do {x_array[i] := 0; segment_S4_P4_B_free := True} goto segment_S4_E;


(* Common segment *)

loc segment_S4_E: invariant x_array[i] <= DURATION_SEGMENT_S4_E
	when x_array[i] = DURATION_SEGMENT_S4_E & clock_abs <= MAX_DURATION do {x_array[i] := 0; segment_S4_E_free := True} sync done_array[i] goto node_E;

loc node_E: invariant True stop{x_array[i]}

end (* pta *)


