	when x_array[i] = DURATION_SEGMENT_S3_P3_B & segment_S3_S4_free do {x_array[i] := 0; segment_S3_S4_free := False} goto segment_S3_Exit_P3;

loc segment_S3_Exit_P3: invariant x_array[i] <= DURATION_SEGMENT_S3_EXIT
	when x_array[i] = DURATION_SEGMENT_S3_EXIT do {x_array[i] := 0; segment_S3_P3_B_free := True} goto segment_S3_S4;

(* S2 : P4 *)
loc segment_S3_Enter_P4: invariant x_array[i] <= DURATION_SEGMENT_S3_ENTER
	when x_array[i] = DURATION_SEGMENT_S3_ENTER do {x_array[i] := 0; segment_S2_S3_free := True} goto segment_S3_P4_A;

loc segment_S3_P4_A: invariant x_array[i] <= DURATION_SEGMENT_S3_P4_A
	when x_array[i] = DURATION_SEGMENT_S3_P4_A & segment_S3_P4_B_free do {x_array[i] := 0; segment_S3_P4_B_free := False} goto segment_S3_P4;

loc segment_S3_P4: invariant x_array[i] <= DURATION_SEGMENT_S3_P4
	when x_array[i] = DURATION_SEGMENT_S3_P4 do {x_array[i] := 0; segment_S3_P4_A_free := True} goto segment_S3_P4_B;

loc segment_S3_P4_B: invariant x_array[i] <= DURATION_SEGMENT_S3_P4_B
	when x_array[i] = DURATION_SEGMENT_S3_P4_B & segment_S3_S4_free do {x_array[i] := 0; segment_S3_S4_free := False} goto segment_S3_Exit_P4;

loc segment_S3_Exit_P4: invariant x_array[i] <= DURATION_SEGMENT_S3_EXIT
	when x_array[i] = DURATION_SEGMENT_S3_EXIT do {x_array[i] := 0; segment_S3_P4_B_free := True} goto segment_S3_S4;

(* Common segment *)

loc segment_S3_S4: invariant x_array[i] <= DURATION_SEGMENT_S3_S4
	when x_array[i] = DURATION_SEGMENT_S3_S4 & segment_S4_P1_A_free do {x_array[i] := 0; segment_S4_P1_A_free := False} goto segment_S4_Enter_P1;
	when x_array[i] = DURATION_SEGMENT_S3_S4 & segment_S4_P2_A_free do {x_array[i] := 0; segment_S4_P2_A_free := False} goto segment_S4_Enter_P2;
	when x_array[i] = DURATION_SEGMENT_S3_S4 & segment_S4_P3_A_free do {x_array[i] := 0; segment_S4_P3_A_free := False} goto segment_S4_Enter_P3;
	when x_array[i] = DURATION_SEGMENT_S3_S4 & segment_S4_P4_A_free do {x_array[i] := 0; segment_S4_P4_A_free := False} goto segment_S4_Enter_P4;

(* S4 : P1 *)
loc segment_S4_Enter_P1: invariant x_array[i] <= DURATION_SEGMENT_S4_ENTER
	when x_array[i] = DURATION_SEGMENT_S4_ENTER do {x_array[i] := 0; segment_S3_S4_free := True} goto segment_S4_P1_A;

loc segment_S4_P1_A: invariant x_array[i] <= DURATION_SEGMENT_S4_P1_A
	when x_array[i] = DURATION_SEGMENT_S4_P1_A & segment_S4_P1_B_free do {x_array[i] := 0; segment_S4_P1_B_free := False} goto segment_S4_P1;

