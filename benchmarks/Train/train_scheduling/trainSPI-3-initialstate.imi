(************************************************************
 *                                IMITATOR MODEL
 *
 * Title            : Some alternative modeling for Figure 4 in "Railway Scheduling Using Boolean Satisfiability Modulo Simulations"
 * Description      : Some alternative modeling for Figure 4 in "Railway Scheduling Using Boolean Satisfiability Modulo Simulations" by Tomáš Kolárik and Stefan Ratschan, i.e., serial-parallel infrastructure, with N_S = N_P = 3
 * Correctness      : Satisfiable schedule
 * Scalable         : yes
 * Generated        : no
 * Categories       : train
 * Source           : "Railway Scheduling Using Boolean Satisfiability Modulo Simulations" by Tomáš Kolárik and Stefan Ratschan. Formal Methods 2023. DOI: https://doi.org/10.1007/978-3-031-27481-7_5
 * bibkey           : [KR23]
 * Author           : Étienne André
 * Modeling         : Étienne André
 * Input by         : Étienne André
 * License          : Creative Commons Attribution-ShareAlike 4.0 International (CC BY-SA 4.0)
 *
 * Created          : 2024/05/02
 * Last modified    : 2024/07/05
 * Model version    : 0.1
 *
 * IMITATOR version : 3.4-alpha
 ************************************************************)

(************************************************************)
(* Initial state *)
(************************************************************)

forall i in [0 , NB-1] : instantiate train[i] := train(i);

init := {

    discrete =
		(*------------------------------------------------------------*)
		(* Initial location *)
		(*------------------------------------------------------------*)

		forall i in [0 , NB-1] : loc[train[i]] := node_S,

		loc[scheduler]	:= loc_1,

		(*------------------------------------------------------------*)
		(* Initial discrete variables assignments *)
		(*------------------------------------------------------------*)
		segment_S_S1_free			:= True,

		segment_S1_P1_A_free		:= True,
		segment_S1_P1_B_free		:= True,
		segment_S1_P2_A_free		:= True,
		segment_S1_P2_B_free		:= True,
		segment_S1_P3_A_free		:= True,
		segment_S1_P3_B_free		:= True,

		segment_S1_S2_free			:= True,

		segment_S2_P1_A_free		:= True,
		segment_S2_P1_B_free		:= True,
		segment_S2_P2_A_free		:= True,
		segment_S2_P2_B_free		:= True,
		segment_S2_P3_A_free		:= True,
		segment_S2_P3_B_free		:= True,

		segment_S2_S3_free			:= True,

		segment_S3_P1_A_free		:= True,
		segment_S3_P1_B_free		:= True,
		segment_S3_P2_A_free		:= True,
		segment_S3_P2_B_free		:= True,
		segment_S3_P3_A_free		:= True,
		segment_S3_P3_B_free		:= True,

		segment_S3_E_free			:= True,
		;

    continuous =
		(*------------------------------------------------------------*)
		(* Initial clock constraints *)
		(*------------------------------------------------------------*)
		forall i in [0 , NB-1] : x_array[i] = 0

		& clock_abs = 0

		& x_last = 0

		(*------------------------------------------------------------*)
		(* Parameter constraints *)
		(*------------------------------------------------------------*)
		& MAX_DURATION >= 0
		& bound_last >= 0
	;
}
